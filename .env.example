# Copy to .env and fill in. Never commit .env.
# All settings are optional; the app runs fully offline with defaults.

# --- Server ---
PORT=3000
HOST=127.0.0.1
# SQLite file path. Use ":memory:" for ephemeral.
DATABASE_PATH=./data/rivalwatch.db
LOG_LEVEL=info

# --- Scheduler ---
# Set to "false" to disable the background scan loop (e.g. when running only the API).
SCHEDULER_ENABLED=true
# How often the scheduler wakes up to look for due pages (seconds).
SCHEDULER_TICK_SECONDS=60

# --- Fetching ---
FETCH_USER_AGENT=RivalWatchBot/0.1 (+https://rivalwatch.example/bot)
FETCH_TIMEOUT_MS=15000
# Minimum delay between two requests to the same host (ms). Be polite.
FETCH_MIN_HOST_DELAY_MS=2000

# --- AI analysis ---
# "heuristic" (free, deterministic, no network) or "anthropic".
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Hard cap on model calls per day to bound cost. 0 = unlimited.
AI_DAILY_CALL_CAP=500

# --- Demo ---
# Serves a fake competitor site at /demo/* whose content can be mutated.
DEMO_SITE_ENABLED=true
