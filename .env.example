# Copy to .env and fill in. Never commit .env.
# The app runs fully offline with defaults (heuristic AI, log-only email, no demo site).

# --- Server ---
NODE_ENV=development            # production: requires PUBLIC_URL, forbids DEMO_SITE_ENABLED, binds 0.0.0.0
PORT=3000
# HOST=127.0.0.1                # default: 127.0.0.1 in development, 0.0.0.0 in production
PUBLIC_URL=http://127.0.0.1:3000  # used in magic links and digest emails; https://... in production
DATABASE_PATH=./data/rivalwatch.db  # container: /data/rivalwatch.db on a persistent volume
LOG_LEVEL=info

# --- Auth ---
# Comma-separated emails that get the owner/admin dashboard on sign-in.
ADMIN_EMAILS=you@example.com
SESSION_DAYS=30
MAGIC_LINK_MINUTES=15

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
# Minutes before a detected change is re-fetched to confirm it (A/B-test and glitch filter). 0 = next fetch.
CONFIRM_DELAY_MINUTES=60
# Weekly digest: ISO weekday 1=Mon..7=Sun, hour in UTC.
DIGEST_WEEKDAY=1
DIGEST_HOUR_UTC=8

# --- Fetching ---
FETCH_USER_AGENT=RivalWatchBot/0.1 (+https://rivalwatch.example/bot)
FETCH_TIMEOUT_MS=15000
FETCH_MIN_HOST_DELAY_MS=2000

# --- AI analysis ---
# "heuristic" (free, deterministic) or "anthropic" (requires ANTHROPIC_API_KEY).
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# USD per million tokens for cost estimates (Haiku 4.5 list price shown).
AI_INPUT_COST_PER_MTOK=1.0
AI_OUTPUT_COST_PER_MTOK=5.0
# Hard caps per rolling 24h; beyond these the heuristic analyser is used. 0 = unlimited.
AI_DAILY_CALL_CAP=300
AI_DAILY_COST_CAP_USD=2

# --- Email ---
# "log" (stored in DB + logs only) or "resend" (requires RESEND_API_KEY and a verified sending domain).
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=RivalWatch <onboarding@resend.dev>

# --- Demo ---
# Serves a fake competitor at /demo/*. Development only; production refuses to start with it on.
DEMO_SITE_ENABLED=false

# --- Founder assistant (/admin/founder, admins only) ---
# FOUNDER_MODEL=claude-sonnet-4-5
# FOUNDER_MAX_COST_PER_TURN_USD=0.5
# FOUNDER_DAILY_COST_CAP_USD=5

# --- Competitor news ---
# NEWS_ENABLED=true
# NEWS_INTERVAL_HOURS=24

# --- Tooling (not read by the app) ---
# GITHUB_TOKEN=   used only by scripts/github-create-repo.mjs
# Devin <-> production shared memory (local .env only; the key is an admin's API key from /settings):
# RIVALWATCH_URL=https://your-app.example
# RIVALWATCH_API_KEY=rw_...
